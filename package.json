{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/unit/**/*.test.ts",
    "supabase:start": "supabase start",
    "dev:local": "pnpm supabase:start && next dev",
    "verify:skeleton": "pnpm lint && pnpm typecheck && pnpm verify:db",
    "verify:unit": "pnpm test:unit",
    "verify:db": "supabase test db",
    "verify:types": "pnpm typecheck",
    "schema:push:dev": "supabase db push",
    "verify:app": "pnpm build",
    "verify:phase": "pnpm verify:skeleton && pnpm verify:unit && pnpm verify:app"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "shadcn": "4.21.0",
    "supabase": "2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.24.0"
}
